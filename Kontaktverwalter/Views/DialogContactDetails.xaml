<Window x:Class="Kontaktverwalter.Views.DialogContactDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kontaktverwalter.Views"
        mc:Ignorable="d"
        Title="Kontaktdetails" Height="350" Width="700" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Contact Details Header with Editable Name -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Content="Vorname:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox x:Name="txtFirstName" Grid.Column="1" Grid.Row="0" 
                         Text="{Binding CurrentValues.FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                         Height="24" Margin="0,0,10,5"
                         Style="{StaticResource ValidatingCell}"/>

                <Label Grid.Column="2" Grid.Row="0" Content="Nachname:" VerticalAlignment="Center" Margin="0,0,5,5"/>
                <TextBox x:Name="txtLastName" Grid.Column="3" Grid.Row="0" 
                         Text="{Binding CurrentValues.LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                         Height="24" Margin="0,0,10,5"
                         Style="{StaticResource ValidatingCell}"/>

                <Button x:Name="btnSave" Grid.Column="4" Grid.Row="0" 
                        Content="Speichern" Width="75" Height="24" 
                        Command="{Binding SaveCommand}" Margin="0,0,10,5"/>

                <TextBlock Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1" 
                           FontSize="12" Foreground="#666666" 
                           Text="{Binding CurrentValues.DateOfBirth, StringFormat='Geboren: {0}'}"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="5">
            <!-- Addresses Grid -->
            <TabItem Header="Anschriften">
                <DataGrid x:Name="dataGrid_Addresses" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" VerticalScrollBarVisibility="Auto" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Straße" Binding="{Binding StreetName}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Hausnummer" Binding="{Binding StreetNumber}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="PLZ" Binding="{Binding PostalCode}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ort" Binding="{Binding City}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Land" Binding="{Binding Country}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Phone Numbers Grid -->
            <TabItem Header="Telefonnummern">
                <DataGrid x:Name="dataGrid_PhoneNumbers" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" VerticalScrollBarVisibility="Auto" Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Telefonnummer" Binding="{Binding PhoneNumber}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Close Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
            <Button x:Name="btnClose" Content="Schließen" Width="75" Height="30" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
