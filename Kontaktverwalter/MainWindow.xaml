<Window x:Class="Kontaktverwalter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kontaktverwalter"
        mc:Ignorable="d"
        Title="Kontaktverwalter" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="5,5,5,5">
            <TextBox x:Name="txtNameSearch" Width="200" Text="{Binding txtNameSearchContent, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
            <Button x:Name="btnStartSearch" Content="Suchen" HorizontalAlignment="Left" Margin="5,0,0,0" Width="75" Height="22" Command="{Binding SearchCommand}"/>
        </StackPanel>
        
        <DataGrid x:Name="dataGrid_ContactView" Grid.Row="1" Margin="5,0,5,5"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                  HeadersVisibility="Column" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                  SelectionUnit="CellOrRowHeader" SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="*"/>
                <DataGridTextColumn Header="Vorname" Binding="{Binding FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Width="*"/>
                <DataGridTextColumn Header="Geboren am" Binding="{Binding DateOfBirth, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="PLZ" Binding="{Binding PostalCode, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Ort" Binding="{Binding City, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Straße" Binding="{Binding StreetName, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="HausNr." Binding="{Binding StreetNumber, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Tel." Binding="{Binding PhoneNumber, Mode=OneWay}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
